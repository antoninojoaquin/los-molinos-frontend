# Copiar a .env.local para desarrollo. En producción van como variables (secretas) del proyecto de Cloudflare Pages.
# Ninguna llega al navegador.

# Cuenta lectora del build (scripts/build-catalog.mjs): usuario de Firebase Auth con email y contraseña,
# con un documento readers/{uid} en Firestore
CATALOG_READER_EMAIL=
CATALOG_READER_PASSWORD=

# Subida de fotos desde el panel (functions/api/upload-signature.js). El preset tiene que estar en modo "Signed"
CLOUDINARY_CLOUD_NAME=dq0fdjwiy
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Deploy hook de Cloudflare Pages (botón "Publicar cambios", functions/api/publish.js)
DEPLOY_HOOK_URL=
