rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Admins: documento admins/{uid} creado a mano desde la consola (el panel muestra el uid)
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Cuenta lectora del build: documento readers/{uid} creado a mano desde la consola.
    // La usa scripts/build-catalog.mjs para generar catalog.json.
    function isReader() {
      return request.auth != null
        && exists(/databases/$(database)/documents/readers/$(request.auth.uid));
    }

    // Solo fotos de la cuenta de Cloudinary del negocio
    function isImage(url) {
      return url is string && url.matches('^https://res[.]cloudinary[.]com/dq0fdjwiy/image/upload/.*');
    }

    // De 1 a 8 fotos (la primera es la principal). Las reglas no tienen bucles: se revisa cada posición.
    function hasValidImages(images) {
      return images is list && images.size() >= 1 && images.size() <= 8
        && isImage(images[0])
        && (images.size() < 2 || isImage(images[1]))
        && (images.size() < 3 || isImage(images[2]))
        && (images.size() < 4 || isImage(images[3]))
        && (images.size() < 5 || isImage(images[4]))
        && (images.size() < 6 || isImage(images[5]))
        && (images.size() < 7 || isImage(images[6]))
        && (images.size() < 8 || isImage(images[7]));
    }

    // Valida el documento completo que queda guardado (mismos límites que el formulario del panel)
    function isValidProduct(p) {
      return p.keys().hasAll(['name', 'category', 'description', 'price', 'inStock', 'images'])
        && p.keys().hasOnly(['name', 'category', 'description', 'price', 'inStock', 'images', 'visible', 'featured'])
        && p.name is string && p.name.size() > 0 && p.name.size() <= 120
        && p.category is string && p.category.size() > 0 && p.category.size() <= 60
        && p.description is string && p.description.size() <= 1000
        && p.price is int && p.price >= 0
        && p.inStock is bool
        // Oculto (false): queda guardado en el panel pero no se publica en la tienda
        && (!('visible' in p) || p.visible is bool)
        // Destacado: aparece en la página de inicio
        && (!('featured' in p) || p.featured is bool)
        && hasValidImages(p.images);
    }

    // Productos: no son públicos. La tienda lee catalog.json, que se genera en el build,
    // así que nadie de afuera puede gastar lecturas.
    match /products/{productId} {
      allow read: if isAdmin() || isReader();
      allow create, update: if isAdmin() && isValidProduct(request.resource.data);
      allow delete: if isAdmin();
    }

    // Cuándo se cambió algo y cuándo se publicó (aviso de "cambios sin publicar" del panel)
    match /meta/catalog {
      allow read: if isAdmin();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['updatedAt', 'publishedAt']);
    }

    // Cada uno puede ver solo su propio documento, para saber si es admin o lector
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /readers/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Todo lo demás queda cerrado por defecto.
  }
}
